/* ============================================================
   ZephyrFTP QSS theme — ports the "Bold Accent" design package's
   assets/zephyr-theme.css tokens to Qt Style Sheets.

   Qt Style Sheets have no equivalent of CSS custom properties, so
   every value below is a literal hardcoded from the CSS source
   (each one commented with its --zf-* token name) rather than a
   variable reference. If the design package's palette changes,
   this file is the other place that needs updating to match —
   there is no single shared source between the two anymore.
   ============================================================ */

QMainWindow, QDialog, QWidget#zfRoot {
    background-color: #14171c;   /* --zf-bg */
    color: #dfe4ea;               /* --zf-text-primary */
}

QToolBar {
    background-color: #1a1d23;   /* --zf-surface */
    border-bottom: 1px solid #2a2e35;   /* --zf-border */
    spacing: 6px;
    padding: 4px 6px;
}

/* --zf-border, brightened — the toolbar grew enough icon groups (Sites/
   Connect/Disconnect, Refresh, the Transfers/Commands view toggles,
   Preferences/About) that the group boundaries needed to actually read
   against QToolBar's own dark surface; the plain --zf-border value used
   for every other divider in the app (QHeaderView, QSplitter) was too
   close to that surface color to serve the same purpose here. */
QToolBar::separator {
    background-color: #3a3f4a;
    width: 1px;
    margin: 4px 6px;
}

/* Without an explicit rule here, QMenuBar was an unstyled child of the
   QMainWindow rule above — it inherited that rule's `color` (QSS color
   cascades to unstyled children) but NOT its `background-color` (falls
   back to native/system rendering instead), an inheritance mismatch that
   happened to look fine on this dark theme by coincidence but produced
   genuinely invisible text on the light theme (dark-on-dark from the
   native background, see theme-light.qss's own copy of this comment). */
QMenuBar {
    background-color: #1a1d23;   /* --zf-surface */
    color: #dfe4ea;               /* --zf-text-primary */
    border-bottom: 1px solid #2a2e35;   /* --zf-border */
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    color: #dfe4ea;               /* --zf-text-primary */
}
QMenuBar::item:selected {
    background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
}
QMenuBar::item:pressed {
    background-color: rgba(91, 141, 239, 40);
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;          /* --zf-radius */
    padding: 6px;
    color: #8790a0;               /* --zf-text-secondary */
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 12);   /* --zf-surface-hover, alpha approximated (QSS rgba alpha is 0-255) */
}
/* The Transfers/Commands toolbar buttons are checkable (they share the
   View menu's own toggleViewAction()) — without this, a checked
   QToolButton painted no differently from an unchecked one once the
   rules above took over its box model, leaving no way to tell which
   docks are currently visible from the toolbar alone. Same blue tint
   QTreeView/QTableWidget selection and QMenu::item:selected already use
   for "this is the active one", not a new color. */
QToolButton:checked {
    background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
}

QTreeView, QTableWidget {
    background-color: #14171c;   /* --zf-bg */
    color: #dfe4ea;               /* --zf-text-primary */
    border: none;
    alternate-background-color: rgba(255, 255, 255, 6);
    selection-background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
    selection-color: #dfe4ea;
    font-size: 12px;
}
QTreeView::item:hover, QTableWidget::item:hover {
    background-color: rgba(255, 255, 255, 10);   /* --zf-surface-hover */
}

/* Commands pane's live log — same dark palette as QTreeView/QTableWidget
   above, since without this a QPlainTextEdit falls back to the platform
   style's default (light) palette, clashing with the rest of the app. */
QPlainTextEdit {
    background-color: #14171c;   /* --zf-bg */
    color: #dfe4ea;               /* --zf-text-primary */
    border: none;
    selection-background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
    selection-color: #dfe4ea;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #1a1d23;   /* --zf-surface */
    color: #dfe4ea;               /* --zf-text-primary — brightened from text-secondary for readability */
    border: none;
    border-bottom: 1px solid #2a2e35;   /* --zf-border */
    border-right: 1px solid #2a2e35;    /* --zf-border — faint divider between header columns */
    padding: 3px 8px;
    font-size: 11px;
}

QLineEdit, QSpinBox, QComboBox {
    background-color: #1a1d23;   /* --zf-surface */
    border: 1px solid #2a2e35;   /* --zf-border */
    color: #dfe4ea;               /* --zf-text-primary */
    padding: 6px 8px;
    border-radius: 6px;          /* --zf-radius */
    font-size: 12px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #5b8def;       /* --zf-blue */
}

/* Without this, the default style draws the drop-down arrow subcontrol
   with its own square-cornered frame, which doesn't respect the
   QComboBox rule's border-radius above — the two right-hand corners of
   the combo box read as squared off against the rounded box they sit
   in. border: none merges it back into the same rounded outline — but
   styling ::drop-down at all makes Qt stop painting its native arrow
   glyph there, so ::down-arrow below has to supply one explicitly. */
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: url(:/icons/chevron-down-muted.svg);
    width: 12px;
    height: 12px;
}

/* An EDITABLE QComboBox (SiteManagerDialog's Group field is this app's
   only one) actually draws its closed-state text via a real CHILD
   QLineEdit overlaid on the combo's own frame — the plain QComboBox
   rule above styles the frame, but this inner editor is a distinct
   widget that needs its own rule, or it falls back to native/system
   palette rendering (a real reported invisible-text bug, only on this
   one editable combo — every other combo in the app draws its own
   closed text directly, no separate child widget involved). border:
   none/background: transparent — the outer QComboBox rule already
   supplies both a visible background and border; painting a second,
   possibly-misaligned one from this inner widget would double up. */
QComboBox QLineEdit {
    background: transparent;
    border: none;
    color: #dfe4ea;               /* --zf-text-primary */
}

/* The dropdown POPUP is a separate widget (QAbstractItemView), not
   covered by the plain QComboBox rule above (which only styles the
   closed control) — without this it falls back to native/system
   palette rendering, unrelated to this theme's own colors. */
QComboBox QAbstractItemView {
    background-color: #1a1d23;   /* --zf-surface */
    color: #dfe4ea;               /* --zf-text-primary */
    border: 1px solid #2a2e35;   /* --zf-border */
    selection-background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
    selection-color: #dfe4ea;
    outline: none;
}

QLabel {
    color: #8790a0;               /* --zf-text-secondary */
    font-size: 11px;
}

/* Without this, QCheckBox's label text falls back to native/system
   palette rendering (unstyled — QSS color inheritance from QDialog/
   QMainWindow above doesn't reliably reach it on every platform this
   app ships for), a real reported invisible-text bug. */
QCheckBox {
    color: #dfe4ea;               /* --zf-text-primary */
    spacing: 6px;
}

/* Same bug, same fix, as QCheckBox above — SiteManagerDialog's
   Authentication (Password/Private key) and starting-directory (Home/
   Specific) radio button labels were unstyled and fell back to
   native/system rendering. */
QRadioButton {
    color: #dfe4ea;               /* --zf-text-primary */
    spacing: 6px;
}

/* Disabled-state text/box colors — without these, every disabled
   QLineEdit/QComboBox/QRadioButton/QCheckBox/QPushButton (e.g. a
   starting-directory field disabled while "Home directory" is
   selected, or proxy fields disabled while proxy type is None) falls
   back to Qt's own native disabled palette, unrelated to this theme —
   a real reported near-invisible-text bug on the light theme
   specifically (see theme-light.qss), reproduced here for symmetry and
   because the dark theme's own native disabled palette isn't
   guaranteed consistent either. Muted but still legible, not merely
   "technically present."
   --zf-text-muted for the text, --zf-bg (flatter than the enabled
   --zf-surface) for the box background — a visibly different, clearly
   "off" look from the enabled state, not just dimmer text on the same
   background. */
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: #5c6472;               /* --zf-text-muted */
    background-color: #14171c;   /* --zf-bg */
    border-color: #2a2e35;       /* --zf-border */
}
QRadioButton:disabled, QCheckBox:disabled {
    color: #5c6472;               /* --zf-text-muted */
}
QPushButton:disabled {
    color: #5c6472;               /* --zf-text-muted */
    border-color: #2a2e35;       /* --zf-border */
}

/* CommandsPaneWidget's bottom-of-pane divider — same token every other
   divider line in the app already uses (QToolBar's own border-bottom,
   QHeaderView::section's border-bottom/border-right). QFrame::HLine
   paints via the palette by default, not a plain background fill, so
   without this it wouldn't reliably read as a visible line against the
   dark theme on every platform this app ships for. */
QFrame#commandsDivider {
    background-color: #2a2e35;   /* --zf-border */
    border: none;
}

QPushButton {
    background: transparent;
    border: 1px solid #2a2e35;   /* --zf-border */
    color: #dfe4ea;               /* --zf-text-primary */
    padding: 6px 14px;
    border-radius: 6px;          /* --zf-radius */
    font-size: 12px;
}
QPushButton:hover {
    background-color: rgba(255, 255, 255, 10);
}

/* Set dynamic property primary="true" on a QPushButton (e.g. a dialog's
   default action) to get the mockup's .zf-action-btn.primary treatment —
   a green-tinted button rather than the neutral default above. */
QPushButton[primary="true"] {
    background-color: rgba(52, 199, 142, 30);   /* --zf-green-tint */
    border-color: #34c78e;       /* --zf-green */
    color: #34c78e;               /* --zf-green */
}
QPushButton[primary="true"]:hover {
    background-color: rgba(52, 199, 142, 45);
}

QStatusBar {
    background-color: #14171c;   /* --zf-bg */
    color: #8790a0;               /* --zf-text-secondary */
    border-top: 1px solid #2a2e35;   /* --zf-border */
    font-size: 11px;
}

QDockWidget {
    color: #dfe4ea;
    titlebar-close-icon: none;
}
QDockWidget::title {
    background-color: #1a1d23;   /* --zf-surface */
    border-bottom: 1px solid #2a2e35;   /* --zf-border */
    padding: 6px 10px;
    font-size: 11px;
}

QMenu {
    background-color: #1a1d23;   /* --zf-surface */
    border: 1px solid #2a2e35;   /* --zf-border */
    color: #dfe4ea;
    padding: 4px;
}
QMenu::item {
    padding: 5px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
}
QMenu::item:disabled {
    color: #5c6472;               /* --zf-text-muted */
}

QProgressBar {
    background-color: #2a2e35;   /* --zf-border, used as track color per .zf-progress-track */
    border: none;
    border-radius: 4px;
    text-align: center;
    color: transparent;           /* hide the built-in percentage text — TransferQueueWidget shows it in its own column */
    max-height: 6px;
}
/* Chunk color is set per-item at runtime via setStyleSheet() on the
   individual QProgressBar (green/blue/red/gray depending on transfer
   status) — see TransferQueueWidget::onItemUpdated(). No single QSS rule
   can do that here since it depends on data, not just widget type. */

QSplitter::handle {
    background-color: #2a2e35;   /* --zf-border */
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #14171c;         /* --zf-bg */
    border: none;
}
QScrollBar::handle {
    background: #2a2e35;         /* --zf-border */
    border-radius: 4px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
