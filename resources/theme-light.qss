/* ============================================================
   ZephyrFTP QSS theme — light variant. Same structure and same
   9-token set as theme.qss (the dark variant this app shipped with
   first), just remapped for a light background — see that file's own
   header comment for why there's no shared-variable mechanism between
   the two (Qt Style Sheets have no CSS-custom-property equivalent).
   Accent colors (--zf-blue, --zf-green) are UNCHANGED from the dark
   variant — saturated enough to read against either background — only
   the neutrals (background/surface/border/text) actually differ.
   ============================================================ */

QMainWindow, QDialog, QWidget#zfRoot {
    background-color: #ffffff;   /* --zf-bg (light) */
    color: #1a1d23;               /* --zf-text-primary (light) */
}

QToolBar {
    background-color: #eef0f3;   /* --zf-surface (light) */
    border-bottom: 1px solid #d8dce2;   /* --zf-border (light) */
    spacing: 6px;
    padding: 4px 6px;
}

/* --zf-border (light), darkened — see theme.qss's own comment on why
   the toolbar's group dividers need more contrast against its surface
   color than the plain border value used everywhere else. */
QToolBar::separator {
    background-color: #c5cad2;
    width: 1px;
    margin: 4px 6px;
}

/* Without an explicit rule here, QMenuBar was an unstyled child of the
   QMainWindow rule above — it inherited that rule's `color` (QSS color
   cascades to unstyled children) but NOT its `background-color` (falls
   back to native/system rendering instead). On the dark theme that
   mismatch happened to look fine by coincidence; on this light theme it
   produced real, reported invisible menu-bar text (dark text drawn
   against whatever the native/system menu-bar background actually is,
   not necessarily this theme's own light surface). */
QMenuBar {
    background-color: #eef0f3;   /* --zf-surface (light) */
    color: #1a1d23;               /* --zf-text-primary (light) */
    border-bottom: 1px solid #d8dce2;   /* --zf-border (light) */
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    color: #1a1d23;               /* --zf-text-primary (light) */
}
QMenuBar::item:selected {
    background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
}
QMenuBar::item:pressed {
    background-color: rgba(91, 141, 239, 40);
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;          /* --zf-radius */
    padding: 6px;
    color: #4a5160;               /* --zf-text-secondary (light) — see IconTheme::Gray()'s own comment on why this was darkened from #5c6472 */
}
QToolButton:hover {
    background-color: rgba(0, 0, 0, 12);   /* --zf-surface-hover — darkens a light surface, mirrors the dark variant's whitening overlay */
}
/* Same blue tint QTreeView/QTableWidget selection and QMenu::item:selected
   already use for "this is the active one" — unchanged from the dark
   variant, see theme.qss's own comment. */
QToolButton:checked {
    background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
}

QTreeView, QTableWidget {
    background-color: #ffffff;   /* --zf-bg (light) */
    color: #1a1d23;               /* --zf-text-primary (light) */
    border: none;
    alternate-background-color: rgba(0, 0, 0, 4);
    selection-background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
    selection-color: #1a1d23;
    font-size: 12px;
}
QTreeView::item:hover, QTableWidget::item:hover {
    background-color: rgba(0, 0, 0, 8);   /* --zf-surface-hover (light) */
}

/* Commands pane's live log — same palette as QTreeView/QTableWidget
   above, see theme.qss's own comment on why this needs an explicit
   rule at all. */
QPlainTextEdit {
    background-color: #ffffff;   /* --zf-bg (light) */
    color: #1a1d23;               /* --zf-text-primary (light) */
    border: none;
    selection-background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
    selection-color: #1a1d23;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #eef0f3;   /* --zf-surface (light) */
    color: #1a1d23;               /* --zf-text-primary (light) */
    border: none;
    border-bottom: 1px solid #d8dce2;   /* --zf-border (light) */
    border-right: 1px solid #d8dce2;    /* --zf-border (light) — faint divider between header columns */
    padding: 3px 8px;
    font-size: 11px;
}

QLineEdit, QSpinBox, QComboBox {
    background-color: #eef0f3;   /* --zf-surface (light) */
    border: 1px solid #d8dce2;   /* --zf-border (light) */
    color: #1a1d23;               /* --zf-text-primary (light) */
    padding: 6px 8px;
    border-radius: 6px;          /* --zf-radius */
    font-size: 12px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #5b8def;       /* --zf-blue */
}

/* Same reasoning as theme.qss's own identical rule. */
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: url(:/icons/chevron-down-muted.svg);
    width: 12px;
    height: 12px;
}

/* An EDITABLE QComboBox draws its closed-state text via a real child
   QLineEdit — see theme.qss's own identical comment for why this needs
   its own rule (SiteManagerDialog's Group field is this app's only
   editable combo, and the specific real reported bug this fixes).
   border: none/background: transparent — the outer QComboBox rule
   already supplies both. */
QComboBox QLineEdit {
    background: transparent;
    border: none;
    color: #1a1d23;               /* --zf-text-primary (light) */
}

/* The dropdown POPUP is a separate widget (QAbstractItemView), not
   covered by the plain QComboBox rule above — see theme.qss's own
   identical comment. Without this, the popup fell back to native/
   system palette rendering — on this theme specifically, a real
   reported bug (white text on a light/white popup background). */
QComboBox QAbstractItemView {
    background-color: #eef0f3;   /* --zf-surface (light) */
    color: #1a1d23;               /* --zf-text-primary (light) */
    border: 1px solid #d8dce2;   /* --zf-border (light) */
    selection-background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
    selection-color: #1a1d23;
    outline: none;
}

QLabel {
    color: #4a5160;               /* --zf-text-secondary (light) — see IconTheme::Gray()'s own comment */
    font-size: 11px;
}

/* Without this, QCheckBox's label text falls back to native/system
   palette rendering — see theme.qss's own identical comment. A real
   reported bug on this theme specifically (invisible-looking text). */
QCheckBox {
    color: #1a1d23;               /* --zf-text-primary (light) */
    spacing: 6px;
}

/* Same bug, same fix, as QCheckBox above — SiteManagerDialog's
   Authentication and starting-directory radio button labels were
   unstyled and fell back to native rendering; a real reported bug on
   this theme specifically. */
QRadioButton {
    color: #1a1d23;               /* --zf-text-primary (light) */
    spacing: 6px;
}

/* Disabled-state text/box colors — see theme.qss's own identical
   comment for the full reasoning. This is the theme the original bug
   report was actually about (a starting-directory field disabled while
   "Home directory" is selected reading as near-invisible against a
   light background under Qt's own native disabled palette). */
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: #78808f;               /* --zf-text-muted (light) */
    background-color: #ffffff;   /* --zf-bg (light) */
    border-color: #d8dce2;       /* --zf-border (light) */
}
QRadioButton:disabled, QCheckBox:disabled {
    color: #78808f;               /* --zf-text-muted (light) */
}
QPushButton:disabled {
    color: #78808f;               /* --zf-text-muted (light) */
    border-color: #d8dce2;       /* --zf-border (light) */
}

/* CommandsPaneWidget's bottom-of-pane divider — same token every other
   divider line here already uses, see theme.qss's own comment. */
QFrame#commandsDivider {
    background-color: #d8dce2;   /* --zf-border (light) */
    border: none;
}

QPushButton {
    background: transparent;
    border: 1px solid #d8dce2;   /* --zf-border (light) */
    color: #1a1d23;               /* --zf-text-primary (light) */
    padding: 6px 14px;
    border-radius: 6px;          /* --zf-radius */
    font-size: 12px;
}
QPushButton:hover {
    background-color: rgba(0, 0, 0, 8);
}

/* Set dynamic property primary="true" on a QPushButton — same
   green-tinted treatment as the dark variant, unchanged. */
QPushButton[primary="true"] {
    background-color: rgba(52, 199, 142, 30);   /* --zf-green-tint */
    border-color: #34c78e;       /* --zf-green */
    color: #1b8f63;               /* darkened green — the dark variant's plain --zf-green (#34c78e) reads as too pale for BODY TEXT on a white background, even though it's fine as a border/tint accent at the same value */
}
QPushButton[primary="true"]:hover {
    background-color: rgba(52, 199, 142, 45);
}

QStatusBar {
    background-color: #ffffff;   /* --zf-bg (light) */
    color: #4a5160;               /* --zf-text-secondary (light) — see IconTheme::Gray()'s own comment */
    border-top: 1px solid #d8dce2;   /* --zf-border (light) */
    font-size: 11px;
}

QDockWidget {
    color: #1a1d23;
    background-color: #eef0f3;   /* --zf-surface (light) — see theme.qss's own comment
                                     on this same rule for why a dock needs its own
                                     background beyond just ::title */
    titlebar-close-icon: none;
}
QDockWidget::title {
    background-color: #eef0f3;   /* --zf-surface (light) */
    border-bottom: 1px solid #d8dce2;   /* --zf-border (light) */
    padding: 6px 10px;
    font-size: 11px;
}

/* Transfers dock's Active/Completed/Failed tabs — see theme.qss's own
   (much longer) comment on this same block for why these rules exist
   at all. Light-theme values only: same border/surface/text tokens
   used elsewhere in this file, --zf-surface-hover darkens instead of
   lightens per this file's own established light-theme convention. */
QTabWidget::pane {
    border: none;
    background-color: #ffffff;   /* --zf-bg (light) */
}
QTabWidget QTabBar {
    background-color: #eef0f3;   /* --zf-surface (light) */
}
QTabBar::tab {
    background-color: transparent;
    color: #4a5160;               /* --zf-text-secondary (light) */
    padding: 6px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}
QTabBar::tab:selected {
    color: #1a1d23;               /* --zf-text-primary (light) */
    border-bottom: 2px solid #5b8def;   /* --zf-blue */
}
QTabBar::tab:hover:!selected {
    color: #1a1d23;               /* --zf-text-primary (light) */
    background-color: rgba(0, 0, 0, 12);   /* --zf-surface-hover */
}

QMenu {
    background-color: #eef0f3;   /* --zf-surface (light) */
    border: 1px solid #d8dce2;   /* --zf-border (light) */
    color: #1a1d23;
    padding: 4px;
}
QMenu::item {
    padding: 5px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: rgba(91, 141, 239, 26);   /* --zf-blue-tint */
}
QMenu::item:disabled {
    color: #78808f;               /* --zf-text-muted (light) — see IconTheme::GrayMuted()'s own comment */
}

QProgressBar {
    background-color: #d8dce2;   /* --zf-border (light), used as track color per .zf-progress-track */
    border: none;
    border-radius: 4px;
    text-align: center;
    color: transparent;           /* hide the built-in percentage text — TransferQueueWidget shows it in its own column */
    max-height: 6px;
}
/* Chunk color is set per-item at runtime via setStyleSheet() on the
   individual QProgressBar — see theme.qss's own identical comment and
   TransferQueueWidget::onItemUpdated()/retintIcons(). */

QSplitter::handle {
    background-color: #d8dce2;   /* --zf-border (light) */
}

/* Same reasoning as theme.qss's own identical rule — a real reported
   bug (non-functional/hard-to-grab scroll bars) fixed by giving the
   track an explicit size and the handle a minimum size, rather than
   leaving either to Qt's own QSS-mode fallback. */
QScrollBar:vertical {
    background: #ffffff;         /* --zf-bg (light) */
    border: none;
    width: 12px;
    margin: 0px;
}
QScrollBar:horizontal {
    background: #ffffff;         /* --zf-bg (light) */
    border: none;
    height: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #d8dce2;         /* --zf-border (light) */
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:horizontal {
    background: #d8dce2;         /* --zf-border (light) */
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}
