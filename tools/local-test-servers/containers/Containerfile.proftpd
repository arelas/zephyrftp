# Real proftpd — a second, independently-coded FTP server (not vsftpd's
# codebase) alongside Containerfile.vsftpd, giving FtpBackend's legacy
# LIST-format fallback a second genuine implementation to be exercised
# against, with its own LIST-format quirks, not just a second run of the
# same server. See ARCHITECTURE.md's Known Gaps entry on FTP vendor
# coverage for why this matters.
#
# Same fedora:44 base as Containerfile.vsftpd (and the SAME image
# build-windows's CI job already uses) — one well-understood base for
# this whole project's containers rather than a second distro.
FROM fedora:44

RUN dnf install -y --setopt=install_weak_deps=False proftpd proftpd-utils openssl && dnf clean all

# No system user created at all — mod_auth_file's UserFile carries its
# own uid/gid fields directly, matched against plain chown below, so
# there's nothing for a real /etc/passwd/PAM lookup to get wrong (see
# proftpd.conf's own comment on why this sidesteps the PAM debugging
# vsftpd's container needed). ftpasswd (proftpd-utils) writes the actual
# password hash; --stdin feeds it non-interactively at build time.
RUN mkdir -p /srv/ftp/uploads \
    && echo "hello from the local proftpd test server" > /srv/ftp/sample.txt \
    && chown -R 1000:1000 /srv/ftp \
    && printf 'proftppass\n' | ftpasswd --passwd --file=/etc/proftpd/proftpd.passwd \
        --name=proftpduser --uid=1000 --gid=1000 --home=/srv/ftp --shell=/sbin/nologin \
        --stdin \
    && touch /etc/proftpd/proftpd.group

COPY proftpd.conf /etc/proftpd/proftpd.conf

# Throwaway CA + leaf cert for FTPS, baked into the image at build time —
# same shape and same reasoning as Containerfile.vsftpd's own build-time
# cert generation (see that file's comment): 10-year validity since this
# bakes in once rather than regenerating per run, SAN IP:127.0.0.1 to
# match what both the control and data connections validate against,
# and only the CA certificate is meant to leave the container (via
# `podman cp`, done by start-proftpd.sh).
RUN openssl genrsa -out /etc/proftpd/ftps-ca-key.pem 2048 \
    && openssl req -x509 -new -key /etc/proftpd/ftps-ca-key.pem -days 3650 \
        -out /etc/proftpd/ftps-ca-cert.pem -subj "/CN=ZephyrFTP proftpd Test CA" \
    && openssl genrsa -out /etc/proftpd/ftps-key.pem 2048 \
    && openssl req -new -key /etc/proftpd/ftps-key.pem \
        -out /tmp/ftps-server.csr -subj "/CN=127.0.0.1" \
    && printf "subjectAltName=IP:127.0.0.1" > /tmp/ftps-san.ext \
    && openssl x509 -req -in /tmp/ftps-server.csr \
        -CA /etc/proftpd/ftps-ca-cert.pem -CAkey /etc/proftpd/ftps-ca-key.pem -CAcreateserial \
        -out /etc/proftpd/ftps-cert.pem -days 3650 -extfile /tmp/ftps-san.ext \
    && chmod 600 /etc/proftpd/ftps-key.pem /etc/proftpd/ftps-ca-key.pem \
    && rm -f /tmp/ftps-server.csr /tmp/ftps-san.ext

EXPOSE 21 2201-2210

# -n: stay in the foreground — proftpd's standalone mode otherwise
# daemonizes the same way vsftpd's did (see Containerfile.vsftpd's
# background=NO comment for the identical underlying problem: podman's
# PID 1 needs the real server process, not a parent that forks and
# immediately exits).
CMD ["/usr/sbin/proftpd", "-n", "--config", "/etc/proftpd/proftpd.conf"]
