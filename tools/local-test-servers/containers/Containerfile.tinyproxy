# Real tinyproxy, not a stand-in — a genuine, independent HTTP CONNECT
# proxy implementation, closing the same kind of gap vsftpd/proftpd
# close for FTP: proving ProxyConnect.cpp's manual HTTP CONNECT
# handshake (see that file's own header comment for why it's hand-rolled
# rather than QAbstractSocket::setProxy()) works against real proxy
# software, not just this project's own test code talking to itself.
#
# fedora:44 base — same image Containerfile.vsftpd/.proftpd already use,
# one well-understood base rather than a third distro just for this.
# BasicAuth is configured (see tinyproxy.conf) specifically so the
# Proxy-Authorization header path in ProxyConnect.cpp's
# httpConnectHandshake() gets real coverage too, not just the
# no-auth case SOCKS5 phase's ssh -D proxy already covers.
FROM fedora:44

RUN dnf install -y --setopt=install_weak_deps=False tinyproxy && dnf clean all

# The tinyproxy package doesn't create its own PID directory — confirmed
# the hard way, not assumed: tinyproxy.conf's PidFile fails with "No
# such file or directory" without this, and tinyproxy refuses to start
# at all rather than skip the PID file.
RUN mkdir -p /var/run/tinyproxy

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf

EXPOSE 8888

CMD ["/usr/sbin/tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
